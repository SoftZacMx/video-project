# Copia este archivo a .env y rellena los valores.
#   cp .env.example .env
#
# .env NUNCA se sube al repo (esta en .gitignore).
# Arranca con:  node --env-file=.env server.mjs

# --- credenciales del usuario IAM dedicado a este proyecto ---
# Solo necesita s3:PutObject + s3:AbortMultipartUpload sobre el bucket,
# y s3:ListBucket sobre el bucket. Nada mas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- destino ---
S3_BUCKET=
S3_PREFIX=discos
S3_STORAGE_CLASS=STANDARD_IA

# --- local ---
OUT_DIR=/Users/brrodriguez/videosTest

# Poner en 1 para ripear sin subir nada (util para probar el lector)
SOLO_LOCAL=0
